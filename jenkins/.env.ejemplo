# Copia este archivo a ".env" y completa los valores. ".env" NO se sube al repo.
JENKINS_ADMIN_PASSWORD=cambia-esta-contrasena
# Secretos de los agentes: se copian desde Jenkins (Nodos -> agente -> "-secret ...")
SECRETO_AGENTE_PYTHON=
SECRETO_AGENTE_BROWSER=
# URL del canal de smee.io (webhooks de GitHub)
SMEE_URL=
